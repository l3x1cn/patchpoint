# Zarządzane przez Ansible (rola patchpoint). Zmienne interpolacji compose.yaml, bez sekretów
# (sekrety API: secrets/api.env).
PATCHPOINT_API_IMAGE={{ patchpoint_image_repo }}/api:{{ patchpoint_image_tag }}
PATCHPOINT_PROXY_IMAGE={{ patchpoint_image_repo }}/proxy:{{ patchpoint_image_tag }}
PATCHPOINT_DOMAIN={{ patchpoint_domain }}
PATCHPOINT_PUBLIC_ORIGINS='["https://{{ patchpoint_domain }}"]'
PATCHPOINT_COOKIE_NAME=__Host-session
PATCHPOINT_TLS_REDIRECT=on
PATCHPOINT_HSTS_MAX_AGE={{ patchpoint_hsts_max_age }}
PATCHPOINT_HTTP_BIND=80
PATCHPOINT_HTTPS_BIND=443
PATCHPOINT_HTTPS_PUBLIC_PORT=443
PATCHPOINT_TLS_DIR={{ patchpoint_dir }}/tls
PATCHPOINT_ACME_DIR={{ patchpoint_dir }}/acme
PATCHPOINT_API_ENV_FILE={{ patchpoint_dir }}/secrets/api.env
PATCHPOINT_BACKEND_SUBNET={{ patchpoint_backend_subnet }}
PATCHPOINT_PROXY_BACKEND_IP={{ patchpoint_proxy_backend_ip }}
