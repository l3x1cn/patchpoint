# PatchPoint: UI i API pod jednym originem. Zastępuje conf.d/default.conf.template obrazu
# owasp/modsecurity-crs; entrypoint podstawia ${...} ze środowiska, a zmienne nginx (np. $uri, $request_uri) zostają.
# ModSecurity jest włączony dla całego kontekstu http w conf.d/modsecurity.conf obrazu.

server_tokens off;
more_clear_headers Server;

# Wyzwania ACME HTTP-01 (Let's Encrypt) nigdy nie idą na HTTPS. Kluczem jest $uri (ścieżka po
# normalizacji), więc segmenty ../ nie omijają przekierowania.
map $uri $patchpoint_redirect_to_tls {
    default ${NGINX_ALWAYS_TLS_REDIRECT};
    ~^/\.well-known/acme-challenge/ off;
}

server {
    listen ${PORT} default_server;
    server_name ${SERVER_NAME};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        default_type text/plain;
        try_files $uri =404;
    }

    if ($patchpoint_redirect_to_tls = on) {
        # Host przekierowania to ten sam host, którego przeglądarka użyła w żądaniu; nagłówka Host nie da się
        # ustawić z cudzej witryny, a stała nazwa zepsułaby wejście przez adres IP (smoke, lokalny stos).
        return 301 https://$host:${SSL_REDIRECT_PORT}$request_uri; # nosemgrep: generic.nginx.security.request-host-used.request-host-used
    }

    include includes/patchpoint-app.conf;
    include includes/location_common.conf;
}

server {
    listen ${SSL_PORT} ssl default_server;
    server_name ${SERVER_NAME};

    ssl_certificate ${SSL_CERT_FILE};
    ssl_certificate_key ${SSL_CERT_KEY_FILE};
    ssl_protocols ${SSL_PROTOCOLS};
    ssl_ciphers ${SSL_CIPHERS};
    ssl_prefer_server_ciphers ${SSL_PREFER_CIPHERS};
    ssl_session_timeout 1d;
    ssl_session_cache shared:PatchPointTLS:10m;
    ssl_session_tickets off;
    ssl_dhparam /etc/ssl/certs/dhparam-${SSL_DH_BITS}.pem;
    ssl_stapling ${SSL_OCSP_STAPLING};
    ssl_stapling_verify ${SSL_OCSP_STAPLING};

    # HSTS bez includeSubDomains i preload: nie zakładamy, że inne subdomeny mają HTTPS.
    more_set_headers "Strict-Transport-Security: max-age=${PATCHPOINT_HSTS_MAX_AGE}";

    include includes/patchpoint-app.conf;
    include includes/location_common.conf;
}
