# Przekazanie /api/ do kontenera API w sieci backend. Zmienna w proxy_pass: nazwa api jest rozwiązywana
# w czasie żądania przez resolver Dockera (resolver w nginx.conf obrazu), więc proxy startuje także bez API
# i po odtworzeniu kontenera API nie trzyma starego adresu.
set $patchpoint_api ${BACKEND};
proxy_pass $patchpoint_api;
proxy_http_version 1.1;
proxy_set_header Connection "";
proxy_set_header Host $host;
# Nadpisany, nie dopisany: proxy jest brzegiem sieci, a API ufa temu nagłówkowi tylko od proxy
# (FORWARDED_ALLOW_IPS), więc wartość od klienta nie trafia do client_ip.
proxy_set_header X-Forwarded-For $remote_addr;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_connect_timeout 5s;
proxy_send_timeout 30s;
proxy_read_timeout 30s;
proxy_redirect off;
